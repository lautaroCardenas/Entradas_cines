<h1>Sala Norte · Back-office</h1>
<p>Ingresá con una cuenta de administrador.</p>

<%= form_with url: session_path do |form| %>
  <div class="field">
    <%= form.label :email_address, "Correo electrónico" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>
  <div class="field">
    <%= form.label :password, "Contraseña" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>
  <%= form.submit "Entrar" %>
<% end %>

<p><%= link_to "¿Olvidaste tu contraseña?", new_password_path %></p>
