<%= form_with model: [ :admin, cinema ] do |f| %>
  <%= form_errors(cinema) %>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>
  <div class="field">
    <%= f.label :address %>
    <%= f.text_field :address, required: true %>
  </div>
  <div class="field">
    <%= f.label :city %>
    <%= f.text_field :city, required: true %>
  </div>
  <%= f.submit "Guardar" %>
<% end %>
