{
  "info": {
    "name": "Sala Norte API",
    "description": "API pública del sistema de cine. Ejecutar las requests en orden: cada una guarda en variables de la colección el token o los IDs que usa la siguiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "movie_id", "value": "" },
    { "key": "screening_id", "value": "" },
    { "key": "seat_ids", "value": "[]" },
    { "key": "order_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login (cliente)",
          "event": [ { "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('token', pm.response.json().token);"
          ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{base_url}}/api/v1/login",
            "body": { "mode": "raw", "raw": "{\n  \"email_address\": \"maria@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login con contraseña incorrecta (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{base_url}}/api/v1/login",
            "body": { "mode": "raw", "raw": "{\n  \"email_address\": \"maria@example.com\",\n  \"password\": \"incorrecta\"\n}" }
          }
        },
        {
          "name": "Registro de cliente nuevo",
          "event": [ { "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('token', pm.response.json().token);"
          ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{base_url}}/api/v1/users",
            "body": { "mode": "raw", "raw": "{\n  \"user\": {\n    \"name\": \"Cliente Demo\",\n    \"email_address\": \"demo{{$randomInt}}@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n  }\n}" }
          }
        },
        {
          "name": "Perfil (requiere token)",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/profile" }
        },
        {
          "name": "Perfil sin token (401)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/v1/profile" }
        }
      ]
    },
    {
      "name": "2. Cartelera (pública)",
      "item": [
        {
          "name": "Sedes",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/v1/cinemas" }
        },
        {
          "name": "Películas en cartelera",
          "event": [ { "listen": "test", "script": { "exec": [
            "const movies = pm.response.json();",
            "if (movies.length) pm.collectionVariables.set('movie_id', movies[0].id);"
          ] } } ],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/v1/movies" }
        },
        {
          "name": "Próximamente",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/v1/movies?status=coming_soon" }
        },
        {
          "name": "Detalle de película con funciones",
          "event": [ { "listen": "test", "script": { "exec": [
            "const upcoming = pm.response.json().screenings.filter(s => !s.sold_out);",
            "if (upcoming.length) pm.collectionVariables.set('screening_id', upcoming[0].id);"
          ] } } ],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/v1/movies/{{movie_id}}" }
        },
        {
          "name": "Película inexistente (404)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/v1/movies/999999" }
        },
        {
          "name": "Función con mapa de asientos",
          "event": [ { "listen": "test", "script": { "exec": [
            "const free = pm.response.json().seats.filter(s => !s.taken).slice(0, 2).map(s => s.id);",
            "pm.collectionVariables.set('seat_ids', JSON.stringify(free));"
          ] } } ],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/v1/screenings/{{screening_id}}" }
        }
      ]
    },
    {
      "name": "3. Compras (requiere token)",
      "item": [
        {
          "name": "Comprar entradas",
          "event": [ { "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('order_id', pm.response.json().id);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{base_url}}/api/v1/orders",
            "body": { "mode": "raw", "raw": "{\n  \"order\": {\n    \"screening_id\": {{screening_id}},\n    \"seat_ids\": {{seat_ids}}\n  }\n}" }
          }
        },
        {
          "name": "Comprar los mismos asientos otra vez (422)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{base_url}}/api/v1/orders",
            "body": { "mode": "raw", "raw": "{\n  \"order\": {\n    \"screening_id\": {{screening_id}},\n    \"seat_ids\": {{seat_ids}}\n  }\n}" }
          }
        },
        {
          "name": "Pagar compra (envía mail de confirmación)",
          "request": { "method": "PATCH", "url": "{{base_url}}/api/v1/orders/{{order_id}}/pay" }
        },
        {
          "name": "Mis entradas",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/orders" }
        },
        {
          "name": "Detalle de compra",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/orders/{{order_id}}" }
        },
        {
          "name": "Cancelar compra (libera asientos)",
          "request": { "method": "PATCH", "url": "{{base_url}}/api/v1/orders/{{order_id}}/cancel" }
        },
        {
          "name": "Logout",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/v1/logout" }
        }
      ]
    }
  ]
}
